NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_OrYp-uaYG6tWoDfx_BvHHg_3zE_mfyY

# Server-only. Required for the "add teacher" admin feature (creates a Supabase Auth user via
# the Admin API) and for admin password resets. NEVER prefix with NEXT_PUBLIC_, never import it
# in a Client Component, and never commit its real value — it bypasses RLS entirely.
# Get it from: Supabase Dashboard -> Project Settings -> API -> service_role secret key.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Multi-centre platform (docs/SAAS.md) ----
# Web Push notifications (generate with: npx web-push generate-vapid-keys). Leave empty to hide the 🔔 button.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=admin@example.com
# Optional: the centre to show on a hostname that isn't any centre's domain (e.g. "madaya").
NEXT_PUBLIC_DEFAULT_CENTER=
# Public demo only: an in-site Postgres with made-up data at /sb. Never set on the real site.
# NEXT_PUBLIC_DEMO=1
